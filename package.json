{
  "name": "lite-server",
  "version": "2.7.0",
  "description": "Lightweight development node server for serving a web app, providing a fallback for browser history API, loading in the browser, and injecting scripts on the fly.",
  "main": "index.js",
  "scripts": {
    "test": "eslint *.js lib/*.js && c8 mocha -R spec"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnpapa/lite-server.git"
  },
  "keywords": [
    "angular",
    "spa",
    "static",
    "server",
    "development"
  ],
  "contributors": [
    "John Papa <john@johnpapa.net>",
    "Christopher Martin <cgmartin@gmail.com>",
    "Daniel Mota <daniel4digital@protonmail.com>"
  ],
  "license": "MIT",
  "bin": {
    "lite-server": "./bin/lite-server"
  },
  "files": [
    "bin/",
    "lib/",
    "index.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/johnpapa/lite-server#readme",
  "dependencies": {
    "browser-sync": "^3.0.4",
    "connect-history-api-fallback": "^2.0.0",
    "connect-logger": "^0.0.1",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0"
  }
}
